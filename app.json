{
  "expo": {
    "name": "RN Tic Tac Toe Challenge",
    "slug": "rn-tic-tac-toe-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "rntictactoechallenge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.thisdotlabs.rntictactoechallenge"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.thisdotlabs.rntictactoechallenge"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/app-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
